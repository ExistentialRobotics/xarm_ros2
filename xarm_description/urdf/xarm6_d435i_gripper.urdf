      <mimicJoint>xarm6_left_finger_joint</mimicJoint>
      <!-- if set to true, PID parameters from "/gazebo_ros_control/pid_gains/${mimic_joint}" are loaded -->
      <hasPID/>
      <multiplier>1.0</multiplier>
      <offset>0</offset>
      <sensitiveness>0.0</sensitiveness>
