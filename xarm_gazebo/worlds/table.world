<?xml version="1.0" ?>
  <sdf version="1.4">
  <world name="default">
    <!-- Plugin to publish model states -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <update_rate>50.0</update_rate>
      <ros>
        <namespace>/</namespace>
      </ros>
    </plugin>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Ground Plane</uri>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Sun</uri>
    </include>
    <!-- Replace prefab table with a simple 10x10x1 m box table -->
    <model name="table_box">

      <!-- Place so the base sits on ground: z = height/2 = 0.5 -->
      <pose>0.7 0.0 0.054 0 0 0</pose>
      <static>true</static>
      <link name="table_link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1 1 0.108</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
                <fdir1>0 0 0</fdir1>
                <slip1>0.0</slip1>
                <slip2>0.0</slip2>
              </ode>
            </friction>
            <contact>
              <ode>
                <kp>1000000.0</kp>
                <kd>100.0</kd>
                <min_depth>0.0001</min_depth>
                <max_vel>100.0</max_vel>
                <fdir1>0 0 0</fdir1>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
                <slip1>0.0</slip1>
                <slip2>0.0</slip2>
              </ode>
            </contact>
            <bounce>
              <restitution_coefficient>0.0</restitution_coefficient>
              <threshold>0.001</threshold>
            </bounce>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>1 1 0.108</size>
            </box>
          </geometry>
        </visual>
        <inertial>
          <mass>10.0</mass>
          <inertia>
            <ixx>0.1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.1</iyy>
            <iyz>0</iyz>
            <izz>0.1</izz>
          </inertia>
        </inertial>
      </link>
      
      <!-- Contact sensor for table surface -->
      <plugin name="table_contact_sensor" filename="libgazebo_ros_contact_sensor.so">
        <contact_topic>table_contacts</contact_topic>
        <collision_name>collision</collision_name>
        <update_rate>100.0</update_rate>
      </plugin>
    </model>

    <!-- Bare minimal block -->
    
    <!-- Bare minimal block with state-publisher plugin -->
    <model name="block">
      <pose>0.38 0.0 0.142 0 0 0</pose>
      <static>false</static>
      
     

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.162 0.086 0.068</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.6</mu>
                <mu2>0.6</mu2>
                <fdir1>0 0 0</fdir1>
                <slip1>0.0</slip1>
                <slip2>0.0</slip2>
              </ode>
            </friction>
            <contact>
              <ode>
                <kp>1000000.0</kp>
                <kd>100.0</kd>
                <min_depth>0.0001</min_depth>
                <max_vel>100.0</max_vel>
                <fdir1>0 0 0</fdir1>
                <mu>0.6</mu>
                <mu2>0.6</mu2>
                <slip1>0.0</slip1>
                <slip2>0.0</slip2>
              </ode>
            </contact>
            <bounce>
              <restitution_coefficient>0.1</restitution_coefficient>
              <threshold>0.001</threshold>
            </bounce>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.162 0.086 0.068</size>
            </box>
          </geometry>
          <material>
            <ambient>1.0 1.0 0.0 1.0</ambient>
            <diffuse>1.0 1.0 0.0 1.0</diffuse>
            <specular>0.5 0.5 0.0 1.0</specular>
          </material>
        </visual>
        <inertial>
          <mass>0.25</mass>
          <inertia>
            <ixx>0.0001</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.0001</iyy>
            <iyz>0</iyz>
            <izz>0.0001</izz>
          </inertia>
        </inertial>
      </link>
      
      <!-- Contact sensor for manipulation feedback -->
      <plugin name="contact_sensor" filename="libgazebo_ros_contact_sensor.so">
        <contact_topic>block_contacts</contact_topic>
        <collision_name>collision</collision_name>
        <update_rate>100.0</update_rate>
      </plugin>
    </model>

    <physics type="ode">
      <max_step_size>0.0005</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>2000</real_time_update_rate>
      <gravity>0 0 -9.81</gravity>
      
      <!-- High-fidelity contact parameters -->
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

  </world>
</sdf>
